{
  "name": "claudescope",
  "version": "0.5.3",
  "private": true,
  "description": "Local, read-only web app to browse, read, search, and analyze your AI coding-agent transcripts — Claude Code, OpenAI Codex, and JetBrains Junie.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "codex",
    "openai",
    "junie",
    "jetbrains",
    "transcripts",
    "sessions",
    "viewer",
    "cli",
    "duckdb"
  ],
  "homepage": "https://github.com/vladar107/claudescope#readme",
  "bugs": "https://github.com/vladar107/claudescope/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladar107/claudescope.git"
  },
  "author": "Vladislav Ramazaev",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node scripts/launch.mjs",
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w @claudescope/server run dev",
    "dev:web": "npm -w @claudescope/web run dev",
    "build": "npm -w @claudescope/shared run build && npm -w @claudescope/web run build && npm -w @claudescope/server run build",
    "bundle": "node scripts/bundle.mjs",
    "serve": "npm -w @claudescope/server run start",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx packages/server/perf/run.ts",
    "bench:compare": "tsx packages/server/perf/compare.ts",
    "update-pricing": "node scripts/update-pricing.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
